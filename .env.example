PERILUNE_DATABASE=./data/perilune.sqlite
# Required for production; must match the browser-visible origin. Use HTTPS remotely.
# Development defaults to http://localhost:4181; set explicitly for other ports.
PERILUNE_ORIGIN=http://localhost:3000

# Optional: direct backend WebSocket URL. Empty keeps simulator mode.
# Live mode is read-only unless individual live workflows are explicitly enabled.
PERILUNE_MOONRAKER_URL=
PERILUNE_MOONRAKER_API_KEY=
# Enables cold bed mesh homing/probing, temporary use/restoration, and explicit
# saving of all pending Klipper configuration with a restart. Other controls stay read-only.
PERILUNE_LIVE_MESH=false
# Shared, acknowledged motion/heater/job controls. Test with an idle printer first.
PERILUNE_LIVE_CONTROLS=false
# Opt-in reviewed single-file configuration upload/restart with recovery snapshots.
# Coordinate printer testing before enabling. Keep other clients idle.
PERILUNE_LIVE_CONFIGURATION=false

# Optional: backend-only go2rtc HTTP API base, e.g. http://go2rtc:1984/
# Empty disables media. With Moonraker, discover a registered src from webcams.
PERILUNE_CAMERA_BASE_URL=
# Optional registered go2rtc stream name; overrides discovery. No RTSP URLs.
PERILUNE_CAMERA_SOURCE=

# Optional stable signing secret (32+ characters). Otherwise a private file is generated
# beside the SQLite database and must be retained with your data.
# PERILUNE_AUTH_SECRET=
