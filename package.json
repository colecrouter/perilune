{
	"name": "perilune",
	"version": "0.0.1",
	"private": true,
	"license": "GPL-3.0-only",
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vp dev",
		"build": "vp build",
		"preview": "vp preview",
		"prepare": "effect-language-service patch && svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"start": "node scripts/server.mjs",
		"test": "vp test run",
		"lint": "vp lint",
		"format": "vp fmt && prettier --write \"src/**/*.svelte\"",
		"format:check": "vp fmt --check && prettier --check \"src/**/*.svelte\"",
		"validate": "vp run format:check && vp run lint && vp run check && vp run test && vp run build && vp run test:smoke",
		"test:smoke": "node scripts/smoke.mjs",
		"test:compose": "node scripts/check-compose.mjs"
	},
	"dependencies": {
		"@effect/sql-sqlite-node": "4.0.4",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/newsreader": "^5.3.0",
		"@opentelemetry/api": "1.9.0",
		"bits-ui": "^2.19.5",
		"effect": "4.0.4",
		"sveltekit-effect": "0.2.0"
	},
	"devDependencies": {
		"@effect/language-service": "^0.87.4",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24.19.2",
		"@vitejs/plugin-legacy": "^8.2.3",
		"@vitest/browser-playwright": "5.0.1",
		"playwright": "^1.64.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "catalog:",
		"vite-plugin-sveltekit-legacy": "0.1.1",
		"vite-plus": "catalog:",
		"vitest-browser-svelte": "^3.1.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.11.2",
			"onFail": "download"
		}
	},
	"engines": {
		"node": ">=24.13"
	}
}
