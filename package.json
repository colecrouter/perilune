{
	"name": "perilune",
	"version": "0.1.0-alpha.2",
	"private": true,
	"license": "GPL-3.0-only",
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vp dev --port 4181",
		"build": "vp build",
		"preview": "vp preview",
		"prepare": "effect-language-service patch && svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit --project src/service-worker/tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"start": "node scripts/server.mjs",
		"test": "vp test run",
		"lint": "vp lint",
		"format": "vp fmt && prettier --write \"src/**/*.svelte\"",
		"format:check": "vp fmt --check && prettier --check \"src/**/*.svelte\"",
		"validate": "pnpm run validate:checks && vp run build && node scripts/smoke-suite.mjs",
		"test:smoke": "node scripts/smoke.mjs",
		"test:backup": "node --test scripts/backup.test.mjs scripts/restore.test.mjs",
		"test:compose": "node scripts/check-compose.mjs",
		"test:release": "node --test scripts/release/bundle.test.mjs scripts/release/manifest-identity.test.mjs scripts/release/wiki.test.mjs && node scripts/check-docs.mjs",
		"test:smoke:live": "node scripts/smoke-live.mjs",
		"test:smoke:camera": "node scripts/smoke-camera.mjs",
		"test:smoke:auth": "node scripts/smoke-auth.mjs",
		"test:smoke:jobs": "node scripts/smoke-jobs.mjs",
		"test:smoke:mesh-probe": "node scripts/smoke-mesh-probe.mjs",
		"test:smoke:calibration": "node scripts/smoke-calibration.mjs",
		"test:smoke:live-mesh": "node scripts/smoke-live-mesh.mjs",
		"test:smoke:extrusion": "node scripts/smoke-extrusion.mjs",
		"test:smoke:configuration": "node scripts/smoke-configuration.mjs",
		"test:smoke:console": "node scripts/smoke-console.mjs",
		"test:smoke:progressive": "node scripts/smoke-progressive.mjs",
		"test:smoke:live-actions": "node scripts/smoke-live-actions.mjs",
		"validate:checks": "vp run format:check && vp run lint && vp run check && vp run test && vp run test:backup && vp run test:release && node scripts/smoke-suite.mjs --check",
		"test:smoke:account-email": "node scripts/smoke-account-email.mjs",
		"generate:config-language": "node scripts/generate-config-language.mjs"
	},
	"dependencies": {
		"@better-auth/kysely-adapter": "1.7.7",
		"@better-auth/passkey": "1.7.7",
		"@codemirror/autocomplete": "^6.20.4",
		"@codemirror/commands": "^6.11.1",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/lang-yaml": "^6.1.3",
		"@codemirror/language": "^6.13.1",
		"@codemirror/lint": "^6.9.7",
		"@codemirror/search": "^6.7.2",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.14",
		"@effect/sql-sqlite-node": "4.0.4",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/newsreader": "^5.3.0",
		"@lezer/common": "^1.5.3",
		"@lezer/highlight": "^1.2.5",
		"@lezer/lr": "^1.4.11",
		"@opentelemetry/api": "1.9.0",
		"@replit/codemirror-vscode-keymap": "^6.0.2",
		"@tanstack/svelte-table": "^9.3.1",
		"better-auth": "1.7.7",
		"bits-ui": "^2.19.5",
		"d3-scale": "^4.0.2",
		"d3-shape": "^3.2.0",
		"effect": "4.0.4",
		"kysely": "0.29.6",
		"layerchart": "^2.7.0",
		"nodemailer": "^10.1.7",
		"sveltekit-effect": "0.2.0",
		"web-push": "^3.6.7"
	},
	"devDependencies": {
		"@effect/language-service": "^0.87.4",
		"@lezer/generator": "^1.8.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-shape": "^3.2.0",
		"@types/node": "^24.19.2",
		"@types/nodemailer": "^8.0.2",
		"@types/web-push": "^3.6.4",
		"@types/ws": "^8.18.2",
		"@vitejs/plugin-legacy": "^8.2.3",
		"@vitest/browser-playwright": "5.0.1",
		"playwright": "^1.64.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"sharp": "^0.35.5",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "catalog:",
		"vite-plugin-sveltekit-legacy": "0.1.1",
		"vite-plus": "catalog:",
		"vitest-browser-svelte": "^3.1.0",
		"ws": "^8.22.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.11.2",
			"onFail": "download"
		}
	},
	"engines": {
		"node": ">=24.13"
	}
}
